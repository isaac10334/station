{
  "name": "station-workspace",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*",
    "vendor/loop-kit/*"
  ],
  "scripts": {
    "dev": "bun run --cwd apps/station dev",
    "start": "bun run --cwd apps/station start",
    "build": "bun run --cwd apps/station build",
    "styles": "bun run --cwd apps/station styles",
    "build:component": "bun run --cwd apps/station build:component",
    "typecheck": "bun run prepare:web && bun run --cwd apps/station typecheck && bun run --cwd packages/ui typecheck && bun run --cwd apps/site typecheck",
    "verify:component": "bun run --cwd apps/station verify:component",
    "setup:sandbox": "bun run --cwd apps/station setup:sandbox",
    "desktop:prepare": "bun run --cwd apps/station desktop:prepare",
    "desktop:build": "bun run --cwd apps/station desktop:build",
    "desktop:dev": "bun run --cwd apps/station desktop:dev",
    "prepare:web": "bun run --cwd apps/station prepare:web",
    "test": "bun test",
    "test:release": "bun test tests/release.test.ts",
    "prepare:release": "bun scripts/prepare-canary-release.ts",
    "build:sdk": "bun run build:packages",
    "build:site": "bun run build:packages && bun run --cwd apps/site build && bun run verify:site",
    "verify:site": "bun scripts/verify-site.ts",
    "dev:site": "bun run build:packages && bun run --cwd apps/site dev",
    "build:packages": "bun run --cwd packages/capabilities build && bun run --cwd packages/sdk build && bun run --cwd packages/ui build"
  },
  "registries": {
    "@stealth": "https://stealth.pm/r/{name}.json",
    "@magicui": "https://magicui.design/r/{name}.json",
    "@react-bits": "https://reactbits.dev/r/{name}.json",
    "@svgl": "https://svgl.app/r/{name}.json"
  }
}
