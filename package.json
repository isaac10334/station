{
  "name": "unit-workspace",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "bun run styles && bun --watch server.ts",
    "start": "bun server.ts",
    "build": "bun run styles && bun scripts/embed-sample-source.ts && bun build --compile --target=browser ./index.html --outdir=dist",
    "styles": "bunx --bun tailwindcss -i ./src/tailwind.css -o ./src/generated.css && bun scripts/copy-font-assets.ts",
    "build:component": "cargo +nightly-2026-09-08 build --release --offline --locked --target wasm32-wasip2 --manifest-path components/greeting/Cargo.toml && bun scripts/embed-sample-source.ts && bun scripts/verify-component.ts",
    "typecheck": "tsc --noEmit",
    "verify:component": "bun scripts/verify-component.ts",
    "setup:sandbox": "bun scripts/setup-vercel-sandbox.ts && bun scripts/prime-vercel-sandbox.ts"
  },
  "dependencies": {
    "@base-ui/react": "^1.8.0",
    "@blobatar/react": "^2.7.0",
    "@codemirror/commands": "^6.11.1",
    "@codemirror/lang-rust": "^6.0.2",
    "@codemirror/state": "^6.7.6",
    "@codemirror/view": "^6.43.13",
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@fontsource-variable/ibm-plex-sans": "^5.3.0",
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "@loop-kit/capabilities": "link:@loop-kit/capabilities",
    "@loop-kit/host": "link:@loop-kit/host",
    "@number-flow/react": "^0.6.2",
    "@polyengine/runtime": "0.6.7",
    "@polyengine/translator": "0.6.7",
    "@polyengine/wasi": "0.6.7",
    "@radix-ui/react-dialog": "^1.1.23",
    "@radix-ui/react-slot": "^1.3.3",
    "@vercel/sandbox": "^3.5.1",
    "blobatar": "^2.7.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "codemirror": "6.0.2",
    "lucide-react": "^1.49.0",
    "motion": "^13.5.0",
    "react": "^19",
    "react-dom": "^19",
    "tailwind-merge": "^3.7.0"
  },
  "devDependencies": {
    "@tailwindcss/cli": "^4.3.3",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/bun": "latest",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "postcss": "^8.5.28",
    "prettier": "^3.9.9",
    "tailwindcss": "^4.3.3",
    "typescript": "5.9.3"
  }
}
