{
  "name": "@station/site",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "bun --watch server.ts",
    "build": "bun ../../tooling/repo.ts assert-reproducible && bun build --target=browser --production ./index.html --outdir=dist",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@station/ui": "workspace:*",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "motion": "^13.5.0"
  },
  "devDependencies": {
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/bun": "latest",
    "typescript": "5.9.3"
  }
}
