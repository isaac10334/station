{
  "name": "@station/app",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "bun run prepare:web && bun run styles && cd ../.. && bun --watch apps/station/server/server.ts",
    "start": "cd ../.. && bun apps/station/server/server.ts",
    "build": "bun run prepare:web && bun run styles && bun scripts/embed-sample-source.ts && bun build --compile --target=browser ./index.html --outdir=dist",
    "styles": "bunx --bun tailwindcss -i ./src/ui/tailwind.css -o ./src/ui/generated.css && bun scripts/copy-font-assets.ts",
    "build:component": "cargo +nightly-2026-09-08 build --release --offline --locked --target wasm32-wasip2 --manifest-path ../../components/greeting/Cargo.toml && bun scripts/embed-sample-source.ts && bun scripts/verify-component.ts",
    "typecheck": "tsc --noEmit",
    "verify:component": "bun scripts/verify-component.ts",
    "setup:sandbox": "cd ../.. && bun apps/station/scripts/setup-vercel-sandbox.ts && bun apps/station/scripts/prime-vercel-sandbox.ts",
    "desktop:prepare": "bunx electrobun prepare --env=canary",
    "desktop:build": "bun run build && bun scripts/prepare-desktop.ts && bunx electrobun build --env=canary",
    "desktop:dev": "bun run build && bun scripts/prepare-desktop.ts && bunx electrobun dev",
    "prepare:web": "bun run --cwd ../.. build:packages && bun scripts/prepare-web-tools.ts",
    "test": "bun test tests",
    "build:sdk": "bun run --cwd ../.. build:packages"
  },
  "dependencies": {
    "@base-ui/react": "^1.8.0",
    "@blobatar/react": "^2.7.0",
    "@codemirror/autocomplete": "6.20.3",
    "@codemirror/commands": "^6.11.1",
    "@codemirror/lang-css": "6.3.1",
    "@codemirror/lang-html": "6.4.12",
    "@codemirror/lang-javascript": "6.2.5",
    "@codemirror/lang-json": "6.0.2",
    "@codemirror/lang-rust": "^6.0.2",
    "@codemirror/language": "6.12.4",
    "@codemirror/lint": "6.9.7",
    "@codemirror/state": "^6.7.6",
    "@codemirror/view": "^6.43.13",
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@fontsource-variable/ibm-plex-sans": "^5.3.0",
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "@lezer/highlight": "1.2.5",
    "@loop-kit/capabilities": "workspace:*",
    "@loop-kit/host": "workspace:*",
    "@number-flow/react": "^0.6.2",
    "@polyengine/runtime": "0.6.7",
    "@polyengine/translator": "0.6.7",
    "@polyengine/wasi": "0.6.7",
    "@radix-ui/react-dialog": "^1.1.23",
    "@radix-ui/react-slot": "^1.3.3",
    "@vercel/sandbox": "^3.5.1",
    "ai": "7.0.136",
    "blobatar": "^2.7.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "codemirror": "6.0.2",
    "csstype": "3.2.3",
    "esbuild-wasm": "0.28.2",
    "lucide-react": "^1.49.0",
    "motion": "^13.5.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "scheduler": "0.28.0",
    "tailwind-merge": "^3.7.0",
    "zod": "4.6.5",
    "@station/sdk": "workspace:*",
    "@station/capabilities": "workspace:*",
    "@station/ui": "workspace:*"
  },
  "devDependencies": {
    "@tailwindcss/cli": "^4.3.3",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/bun": "latest",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "electrobun": "2.0.2",
    "postcss": "^8.5.28",
    "prettier": "^3.9.9",
    "tailwindcss": "^4.3.3",
    "typescript": "5.9.3"
  }
}
