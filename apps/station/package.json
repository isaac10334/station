{
  "name": "@station/app",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "bun scripts/dev.ts",
    "start": "cd ../.. && bun apps/station/server/server.ts",
    "build": "bun ../../tooling/repo.ts assert-reproducible && bun run prepare:web && bun run styles && bun scripts/embed-sample-source.ts && bun build --compile --target=browser --production ./index.html --outdir=dist",
    "styles": "bunx --bun tailwindcss -i ./src/ui/tailwind.css -o ./src/ui/generated.css && bun scripts/copy-font-assets.ts",
    "build:component": "cargo +nightly-2026-09-08 build --release --offline --locked --target wasm32-wasip2 --manifest-path ../../components/greeting/Cargo.toml && bun scripts/embed-sample-source.ts && bun scripts/verify-component.ts",
    "typecheck": "tsc --noEmit",
    "verify:component": "bun scripts/verify-component.ts",
    "setup:sandbox": "cd ../.. && bun apps/station/scripts/setup-vercel-sandbox.ts && bun apps/station/scripts/prime-vercel-sandbox.ts",
    "desktop:prepare": "bunx electrobun prepare --env=canary",
    "desktop:build": "bun run build && bun scripts/prepare-desktop.ts && bun scripts/build-browser-native.ts && bunx electrobun build --env=canary",
    "desktop:dev": "bun scripts/dev-desktop.ts",
    "prepare:web": "bun run --cwd ../.. build:packages && bun scripts/prepare-scripting.ts && bun scripts/prepare-web-tools.ts && bun run prepare:vectorcraft",
    "test": "bun test tests",
    "prepare:vectorcraft": "bun scripts/prepare-vectorcraft.ts"
  },
  "dependencies": {
    "@base-ui/react": "^1.8.0",
    "@blobatar/react": "^2.7.0",
    "@blocknote/core": "0.56.0",
    "@blocknote/react": "0.56.0",
    "@blocknote/shadcn": "0.56.0",
    "@codemirror/autocomplete": "6.20.3",
    "@codemirror/commands": "^6.11.1",
    "@codemirror/lang-css": "6.3.1",
    "@codemirror/lang-html": "6.4.12",
    "@codemirror/lang-javascript": "6.2.5",
    "@codemirror/lang-json": "6.0.2",
    "@codemirror/lang-rust": "^6.0.2",
    "@codemirror/language": "6.12.4",
    "@codemirror/lint": "6.9.7",
    "@codemirror/state": "^6.7.6",
    "@codemirror/view": "^6.43.13",
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@fontsource-variable/ibm-plex-sans": "^5.3.0",
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "@jitl/quickjs-singlefile-browser-release-sync": "^0.32.0",
    "@lezer/highlight": "1.2.5",
    "@loop-kit/capabilities": "^0.1.0",
    "@loop-kit/host": "^0.1.0",
    "@loop-kit/scripting": "^0.1.0",
    "@loop-kit/ui": "^0.1.0",
    "@modelcontextprotocol/client": "2.3.1",
    "@modelcontextprotocol/server": "2.3.1",
    "@number-flow/react": "^0.6.2",
    "@polyengine/runtime": "0.6.7",
    "@polyengine/translator": "0.6.7",
    "@polyengine/wasi": "0.6.7",
    "@radix-ui/react-dialog": "^1.1.23",
    "@radix-ui/react-slot": "^1.3.3",
    "@station/capabilities": "workspace:*",
    "@station/protocol": "workspace:*",
    "@station/sdk": "workspace:*",
    "@station/ui": "workspace:*",
    "@svgedit/svgcanvas": "7.4.2",
    "@vercel/sandbox": "^3.5.1",
    "@xyflow/react": "^12.12.0",
    "ai": "7.0.136",
    "better-auth": "1.6.23",
    "blobatar": "^2.7.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "codemirror": "6.0.2",
    "csstype": "3.2.3",
    "esbuild-wasm": "0.28.2",
    "fflate": "0.8.2",
    "lucide-react": "^1.49.0",
    "motion": "^13.5.0",
    "pg": "8.16.3",
    "prettier": "^3.9.9",
    "quickjs-emscripten-core": "^0.32.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "scheduler": "0.28.0",
    "tailwind-merge": "^3.7.0",
    "typescript": "5.9.3",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@tailwindcss/cli": "^4.3.3",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/bun": "latest",
    "@types/pg": "^8.23.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "electrobun": "2.0.3-beta.26",
    "happy-dom": "21.0.1",
    "postcss": "^8.5.28",
    "tailwindcss": "^4.3.3"
  }
}
